# ===== 模型接入（可选）=====
# 不填也能跑：系统会自动降级到规则引擎，界面右上角会显示「规则模式」
# 任何兼容 OpenAI Chat Completions 的服务都可以，填 baseURL + key + model 即可
OPENAI_API_KEY=sk-37a8ec8ce444478680cfdf9e4c9109b9
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-flash

# ===== 服务 =====
# 端口被占用时会自动 +1 重试
PORT=5178
# 单份简历大小上限（MB）
MAX_FILE_MB=8
# 并发处理简历数
SCREEN_CONCURRENCY=3

# ===== 演示开关 =====
# 置 1 可强制走规则引擎，用来现场演示「模型不可用时系统仍然可用」的降级路径
DEMO_FORCE_RULE=

# ===== 调优 =====
LLM_TIMEOUT_MS=60000
LLM_RETRIES=2
LLM_TEMPERATURE=0.1
