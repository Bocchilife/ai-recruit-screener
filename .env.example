# ---------------------------------------------------------------------------
# 模型配置（可选）
# 不填也能跑：系统会自动降级到规则引擎，界面右上角会显示「规则模式」
# 任何兼容 OpenAI Chat Completions 的服务都可以，填 baseURL + key + model 即可
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# 一次判定要输出 10 条左右的 JSON，DeepSeek 长输出经常 60s+，别把超时压太短
LLM_TIMEOUT_MS=150000
# 失败重试次数（超时 / 5xx / 429 / JSON 截断才重试，4xx 鉴权错误不重试）
LLM_RETRIES=3
# 单次输出上限；输出被截断时会自动放大到 1.8 倍再试一次（最多 8192）
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# ---------------------------------------------------------------------------
# 服务配置
# ---------------------------------------------------------------------------
# 端口被占用时会自动 +1 重试
PORT=5178
# 单份简历大小上限（MB）
MAX_FILE_MB=8
# 并发处理简历数
SCREEN_CONCURRENCY=3

# ---------------------------------------------------------------------------
# 置 1 可强制走规则引擎，用来现场演示「模型不可用时系统仍然可用」的降级路径
# ---------------------------------------------------------------------------
DEMO_FORCE_RULE=
